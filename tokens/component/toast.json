{
  "component": {
    "toast": {
      "$description": "Toast — 중립 base + 상태 4계열(success/danger/warning/info), raised 쌍 + 모션",
      "bg": {
        "$value": "{semantic.color.bg.surface-raised}",
        "ref": "color.bg.surface-raised"
      },
      "elevation": {
        "$value": "{semantic.elevation.raised}",
        "ref": "elevation.raised"
      },
      "stroke": {
        "$value": "{semantic.color.stroke.subtle}",
        "ref": "color.stroke.subtle"
      },
      "radius": {
        "$value": "{semantic.radius.container}",
        "ref": "radius.container"
      },
      "inset": {
        "$value": "{semantic.spacing.inset.md}",
        "ref": "spacing.inset.md"
      },
      "gap": {
        "$value": "{semantic.spacing.inline.md}",
        "ref": "spacing.inline.md"
      },
      "fg": {
        "$value": "{semantic.color.fg.primary}",
        "ref": "color.fg.primary"
      },
      "icon": {
        "$value": "{semantic.size.icon.md}",
        "ref": "size.icon.md"
      },
      "status": {
        "success": {
          "accent-fg": {
            "$value": "{semantic.color.fg.success}",
            "ref": "color.fg.success"
          },
          "accent-bg": {
            "$value": "{semantic.color.bg.success-subtle}",
            "ref": "color.bg.success-subtle"
          }
        },
        "danger": {
          "accent-fg": {
            "$value": "{semantic.color.fg.danger}",
            "ref": "color.fg.danger"
          },
          "accent-bg": {
            "$value": "{semantic.color.bg.danger-subtle}",
            "ref": "color.bg.danger-subtle"
          }
        },
        "warning": {
          "accent-fg": {
            "$value": "{semantic.color.fg.warning}",
            "ref": "color.fg.warning"
          },
          "accent-bg": {
            "$value": "{semantic.color.bg.warning-subtle}",
            "ref": "color.bg.warning-subtle"
          }
        },
        "info": {
          "accent-fg": {
            "$value": "{semantic.color.fg.info}",
            "ref": "color.fg.info"
          },
          "accent-bg": {
            "$value": "{semantic.color.bg.info-subtle}",
            "ref": "color.bg.info-subtle"
          }
        }
      },
      "motion": {
        "enter": {
          "$value": "{semantic.motion.overlay-enter}",
          "ref": "motion.overlay-enter"
        },
        "exit": {
          "$value": "{semantic.motion.overlay-exit}",
          "ref": "motion.overlay-exit"
        }
      }
    }
  }
}