{
  "component": {
    "modal": {
      "$description": "Modal — scrim + surface-overlay(elevation.overlay 쌍) + enter/exit 모션",
      "scrim": {
        "$value": "{semantic.color.bg.scrim}",
        "ref": "color.bg.scrim"
      },
      "surface": {
        "$value": "{semantic.color.bg.surface-overlay}",
        "ref": "color.bg.surface-overlay"
      },
      "elevation": {
        "$value": "{semantic.elevation.overlay}",
        "ref": "elevation.overlay"
      },
      "bdr": {
        "$value": "{semantic.color.bdr.subtle}",
        "ref": "color.bdr.subtle"
      },
      "radius": {
        "$value": "{semantic.radius.overlay}",
        "ref": "radius.overlay"
      },
      "padding": {
        "$value": "{semantic.spacing.padding.lg}",
        "ref": "spacing.padding.lg"
      },
      "gap": {
        "$value": "{semantic.spacing.gap.y.md}",
        "ref": "spacing.gap.y.md"
      },
      "close-icon": {
        "$value": "{semantic.size.icon.md}",
        "ref": "size.icon.md"
      },
      "motion": {
        "enter": {
          "$value": "{semantic.motion.overlay-enter}",
          "ref": "motion.overlay-enter"
        },
        "exit": {
          "$value": "{semantic.motion.overlay-exit}",
          "ref": "motion.overlay-exit"
        }
      },
      "typography": {
        "title": {
          "$value": "{semantic.typography.heading}",
          "ref": "typography.heading"
        },
        "body": {
          "$value": "{semantic.typography.body}",
          "ref": "typography.body"
        }
      }
    }
  }
}